roid_timing_max_attempts\":10},\"is_device_based\":false,\"passed\":false},\"1623104352\":{\"name\":\"1623104352\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":25,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"842715733\":{\"name\":\"842715733\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"inside_bubble\",\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"2801269291\":{\"name\":\"2801269291\",\"rule_id\":\"3GogURDyenQHgosA47nZdx-3GogUPYvM5HcWYUEsZslUv\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"apps\":[\"asdk_app_693ca6ce2db08191bb52d66743c65184\",\"connector_76869538009648d5b282a4bb21c3d157\",\"asdk_app_69377d07cd9c8191a988f06f15b8c674\",\"connector_5f3c8c41a1e54ad7a76272c89e2554fa\",\"connector_692de805e3ec8191834719067174a384\",\"connector_68df33b1a2d081918778431a9cfca8ba\",\"connector_69312da8e4dc81919370cb86fd172b6c\"]},\"is_device_based\":false,\"passed\":true},\"1426425582\":{\"name\":\"1426425582\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Live-only create\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"2674049786\":{\"name\":\"2674049786\",\"rule_id\":\"2bhHmMHET8reOVGWwK3yCT\",\"secondary_exposures\":[],\"version\":20,\"id_type\":\"userID\",\"value\":{\"variant\":\"test\"},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"2133596510\":{\"name\":\"2133596510\",\"rule_id\":\"USeZCOloSU02kTe6xjZuA\",\"secondary_exposures\":[],\"version\":20,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_exper